<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[
; ============================================================================
; CLIMATE STRESS TEST — BRAZIL 2026–2030
; Exploratory Agent-Based Model (ABM)
; NetLogo 7.0.4
;
; v2.1 — Formal Experiment Metrics / Reproducibility Logic
;
; IMPORTANT:
; This is an exploratory stress-testing model, NOT an official forecast.
; Climate drivers are normalized experimental inputs (0–100), not physical
; units. Empirical calibration should be performed before predictive use.
; ============================================================================


; ============================================================================
; MODEL ENTITIES
; ============================================================================

breed [municipalities municipality]
undirected-link-breed [dependencies dependency]


; ============================================================================
; MUNICIPALITY ATTRIBUTES
; ============================================================================

municipalities-own [
  region

  ; Static / initial characteristics
  exposure
  vulnerability
  resilience

  water-sensitivity
  agriculture-sensitivity
  urban-sensitivity
  heat-sensitivity

  ; Dynamic state variables
  hazard
  water-stress
  agricultural-impact
  energy-stress
  economic-impact
  cascade-load
  local-risk
  damage
  recovery-capacity
  status
]


; ============================================================================
; DEPENDENCY ATTRIBUTES
; ============================================================================

dependencies-own [
  dependency-weight
]


; ============================================================================
; GLOBAL STATE
; ============================================================================

globals [
  ; Aggregate risk indicators
  system-risk
  average-water-stress
  average-agricultural-impact
  average-energy-stress
  average-economic-impact
  average-damage
  average-recovery-capacity

  ; Peak indicators
  peak-system-risk
  peak-average-damage

  ; System state
  critical-municipalities

  ; Cascade indicators
  cascade-events
  total-cascade-events
  total-cascade-load

  ; Temporal state
  current-year
  current-month

  ; Effective scenario protection
  effective-adaptation
  effective-infrastructure

  ; Reproducibility
  random-seed-value

  ; Observed network structure
  network-edge-count
  network-mean-degree
  network-realized-density
]


; ============================================================================
; SETUP
; ============================================================================

; ---------------------------------------------------------------------------
; Default reproducible setup.
;
; This keeps the original fixed-seed behavior for normal interactive runs.
; ---------------------------------------------------------------------------

to setup
  setup-with-seed 20260916
end


; ---------------------------------------------------------------------------
; Generalized setup procedure.
;
; This is the procedure to use for:
; - replication testing
; - Monte Carlo experiments
; - BehaviorSpace
; - automated headless execution
; ---------------------------------------------------------------------------

to setup-with-seed [seed-value]

  clear-all

  ; -------------------------------------------------------------------------
  ; RANDOM SEED
  ; -------------------------------------------------------------------------

  set random-seed-value seed-value
  random-seed random-seed-value


  ; -------------------------------------------------------------------------
  ; TIME
  ; -------------------------------------------------------------------------

  set current-year 2026
  set current-month 1


  ; -------------------------------------------------------------------------
  ; GLOBAL METRICS
  ; -------------------------------------------------------------------------

  set system-risk 0

  set average-water-stress 0
  set average-agricultural-impact 0
  set average-energy-stress 0
  set average-economic-impact 0
  set average-damage 0
  set average-recovery-capacity 0

  set peak-system-risk 0
  set peak-average-damage 0

  set critical-municipalities 0

  set cascade-events 0
  set total-cascade-events 0
  set total-cascade-load 0

  set network-edge-count 0
  set network-mean-degree 0
  set network-realized-density 0


  ; -------------------------------------------------------------------------
  ; MODEL INITIALIZATION
  ; -------------------------------------------------------------------------

  configure-scenario
  create-municipality-agents
  create-system-network

  calculate-network-metrics
  calculate-all-metrics

  reset-ticks
end


; ============================================================================
; SCENARIOS
; ============================================================================

to configure-scenario

  if scenario-mode = "FAIL OPEN" [
    set effective-adaptation (adaptation-investment * 0.55)
    set effective-infrastructure (infrastructure-resilience * 0.55)
  ]


  if scenario-mode = "BALANCED" [
    set effective-adaptation adaptation-investment
    set effective-infrastructure infrastructure-resilience
  ]


  if scenario-mode = "RESILIENT BY DESIGN" [
    set effective-adaptation min (
      list 100 (adaptation-investment * 1.30)
    )

    set effective-infrastructure min (
      list 100 (infrastructure-resilience * 1.30)
    )
  ]

end




; ============================================================================
; AGENTS
; ============================================================================

to create-municipality-agents

  create-municipalities num-municipalities [

    setxy random-xcor random-ycor

    assign-region
    initialize-municipality
  ]

end


; ============================================================================
; REGION ASSIGNMENT
; ============================================================================

to assign-region

  ifelse xcor < -12 [

    set region "North"

  ] [

    ifelse xcor < -4 [

      set region "Northeast"

    ] [

      ifelse xcor < 4 [

        set region "Midwest"

      ] [

        ifelse xcor < 12 [

          set region "Southeast"

        ] [

          set region "South"

        ]

      ]

    ]

  ]

end


; ============================================================================
; MUNICIPALITY INITIALIZATION
; ============================================================================

to initialize-municipality

  ; -------------------------------------------------------------------------
  ; Controlled synthetic distributions.
  ; These remain stylized until empirical calibration.
  ; -------------------------------------------------------------------------

  set exposure (40 + random 41)
  set vulnerability (40 + random 41)
  set resilience (35 + random 41)

  set water-sensitivity (40 + random 41)
  set agriculture-sensitivity (40 + random 41)
  set urban-sensitivity (35 + random 46)
  set heat-sensitivity (40 + random 41)


  ; -------------------------------------------------------------------------
  ; Stylized regional adjustments
  ; -------------------------------------------------------------------------

  if region = "North" [

    set water-sensitivity min (
      list 100 (water-sensitivity + 5)
    )

    set vulnerability min (
      list 100 (vulnerability + 5)
    )
  ]


  if region = "Northeast" [

    set water-sensitivity min (
      list 100 (water-sensitivity + 15)
    )

    set agriculture-sensitivity min (
      list 100 (agriculture-sensitivity + 10)
    )
  ]


  if region = "Midwest" [

    set agriculture-sensitivity min (
      list 100 (agriculture-sensitivity + 15)
    )
  ]


  if region = "Southeast" [

    set urban-sensitivity min (
      list 100 (urban-sensitivity + 15)
    )

    set heat-sensitivity min (
      list 100 (heat-sensitivity + 10)
    )

    set exposure min (
      list 100 (exposure + 10)
    )
  ]


  if region = "South" [

    set exposure min (
      list 100 (exposure + 5)
    )
  ]


  ; -------------------------------------------------------------------------
  ; Dynamic state initialization
  ; -------------------------------------------------------------------------

  set hazard 0
  set water-stress 0
  set agricultural-impact 0
  set energy-stress 0
  set economic-impact 0
  set cascade-load 0
  set local-risk 0
  set damage 0
  set recovery-capacity 0

  set status "STABLE"

end


; ============================================================================
; DEPENDENCY NETWORK
; ============================================================================

to create-system-network

  ask municipalities [

    ; The user-facing parameter "network-density" controls the desired
    ; number of attempted connections.
    ;
    ; IMPORTANT:
    ; This parameter is retained for compatibility with the existing model.
    ; Actual network structure is measured after creation through:
    ; - network-edge-count
    ; - network-mean-degree

    let wanted-links max (
      list 1 (round (network-density / 2))
    )


    repeat wanted-links [

      let candidate one-of other municipalities


      if candidate != nobody and
         not dependency-neighbor? candidate [

        create-dependency-with candidate [

          set dependency-weight (
            0.30 + random-float 0.70
          )

        ]

      ]

    ]

  ]

end


; ============================================================================
; NETWORK METRICS
; ============================================================================

to calculate-network-metrics

  set network-edge-count count dependencies


  ifelse any? municipalities [

    ; For an undirected network:
    ;
    ; Mean Degree = 2E / N
    ;
    ; E = number of edges
    ; N = number of municipalities

    set network-mean-degree (
      (2 * network-edge-count) /
      count municipalities
    )


    ; Realized density for a simple undirected graph:
    ;
    ; Density = E / [N(N-1)/2]
    ;
    ; This is an observed structural metric. It is intentionally
    ; distinct from the user-facing "network-density" control.

    let possible-edges (
      (count municipalities) *
      ((count municipalities) - 1) /
      2
    )


    ifelse possible-edges > 0 [
      set network-realized-density (
        network-edge-count /
        possible-edges
      )
    ] [
      set network-realized-density 0
    ]

  ] [

    set network-mean-degree 0
    set network-realized-density 0

  ]

end


; ============================================================================
; MAIN SIMULATION LOOP
; ============================================================================

to go

  ; -------------------------------------------------------------------------
  ; Five-year experimental horizon
  ; -------------------------------------------------------------------------

  if ticks >= 60 [
    stop
  ]


  ; -------------------------------------------------------------------------
  ; Temporal state
  ; -------------------------------------------------------------------------

  set current-year (
    2026 + floor (ticks / 12)
  )

  set current-month (
    1 + (ticks mod 12)
  )


  ; -------------------------------------------------------------------------
  ; Scenario configuration
  ; -------------------------------------------------------------------------

  configure-scenario


  ; -------------------------------------------------------------------------
  ; LOCAL MUNICIPAL PROCESSES
  ; -------------------------------------------------------------------------

  ask municipalities [

    update-local-hazard
    calculate-local-risk
    update-sector-impacts

  ]


  ; -------------------------------------------------------------------------
  ; SYSTEMIC PROCESSES
  ; -------------------------------------------------------------------------

  propagate-cascades

  apply-adaptation

  apply-recovery


  ; -------------------------------------------------------------------------
  ; GLOBAL METRICS
  ; -------------------------------------------------------------------------

  calculate-network-metrics
  calculate-all-metrics


  ; -------------------------------------------------------------------------
  ; Advance simulation
  ; -------------------------------------------------------------------------

  tick

end


; ============================================================================
; CLIMATE PRESSURE / HAZARD
; ============================================================================

to update-local-hazard

  ; Approx. 1.2% annual temporal drift across the 2026–2030 experiment.
  let monthly-load (
    1 + (ticks * (0.012 / 12))
  )


  ; Approx. ±10% seasonal variation.
  let seasonal-factor (
    1.0 + (0.10 * sin (ticks * 30))
  )


  ; Small stochastic process / observation noise.
  let variability (
    (random-float 4) - 2
  )


  let regional-factor 1
  let regional-el-nino 1


  ; -------------------------------------------------------------------------
  ; Stylized regional response coefficients
  ; -------------------------------------------------------------------------

  if region = "North" [

    set regional-factor 1.05
    set regional-el-nino 1.10

  ]


  if region = "Northeast" [

    set regional-factor 1.08
    set regional-el-nino 1.15

  ]


  if region = "Midwest" [

    set regional-factor 1.03
    set regional-el-nino 1.05

  ]


  if region = "Southeast" [

    set regional-factor 1.04
    set regional-el-nino 0.95

  ]


  if region = "South" [

    set regional-factor 1.02
    set regional-el-nino 1.05

  ]


  ; -------------------------------------------------------------------------
  ; Normalized climate pressure
  ;
  ; Warming       = 45%
  ; El Niño       = 20%
  ; Deforestation = 20%
  ; Urban stress  = 15%
  ; -------------------------------------------------------------------------

  let base-pressure (

    (warming-pressure * 0.45) +
    (el-nino-intensity * 0.20 * regional-el-nino) +
    (deforestation-pressure * 0.20) +
    (urban-pressure * 0.15)

  )


  ; -------------------------------------------------------------------------
  ; Final normalized hazard
  ; -------------------------------------------------------------------------

  let adjusted-load (

    (base-pressure *
     regional-factor *
     monthly-load *
     seasonal-factor)

    + variability

  )


  set hazard max (
    list 0 (
      min (list 100 adjusted-load)
    )
  )

end


; ============================================================================
; RUN TO 2030
; ============================================================================

to run-to-2030

  setup

  while [ticks < 60] [
    go
  ]

end


; ============================================================================
; LOCAL RISK
; ============================================================================

to calculate-local-risk

  let raw-risk (
    (hazard * exposure * vulnerability) / 10000
  )


  let resilience-buffer (
    resilience * 0.35
  )


  let infrastructure-buffer (
    effective-infrastructure * 0.20
  )


  let adaptation-buffer (
    effective-adaptation * 0.15
  )


  let calc-risk (

    raw-risk

    - resilience-buffer
    - infrastructure-buffer
    - adaptation-buffer

  )


  set local-risk max (
    list 0 (
      min (list 100 calc-risk)
    )
  )

end


; ============================================================================
; SECTORAL IMPACTS
; ============================================================================

to update-sector-impacts

  ; -------------------------------------------------------------------------
  ; Environmental pressure
  ; -------------------------------------------------------------------------

  let env-pressure (

    (deforestation-pressure * 0.60) +
    (urban-pressure * 0.40)

  )


  ; -------------------------------------------------------------------------
  ; Heat pressure
  ; -------------------------------------------------------------------------

  let heat-pressure (

    (warming-pressure * 0.70) +
    (el-nino-intensity * 0.20) +
    (urban-pressure * 0.10)

  )


  ; -------------------------------------------------------------------------
  ; Water stress
  ; -------------------------------------------------------------------------

  let calc-water (

    (hazard * 0.55) +
    (water-sensitivity * 0.25) +
    (env-pressure * 0.20) -
    (effective-adaptation * 0.18)

  )


  set water-stress max (
    list 0 (
      min (list 100 calc-water)
    )
  )


  ; -------------------------------------------------------------------------
  ; Agricultural impact
  ; -------------------------------------------------------------------------

  let calc-agri (

    (water-stress * 0.50) +
    (heat-pressure * 0.25) +
    (agriculture-sensitivity * 0.25) -
    (effective-adaptation * 0.12)

  )


  set agricultural-impact max (
    list 0 (
      min (list 100 calc-agri)
    )
  )


  ; -------------------------------------------------------------------------
  ; Energy stress
  ; -------------------------------------------------------------------------

  let calc-energy (

    (water-stress * 0.45) +
    (heat-pressure * 0.25) +
    (urban-sensitivity * 0.20) +
    (urban-pressure * 0.10) -
    (effective-infrastructure * 0.15)

  )


  set energy-stress max (
    list 0 (
      min (list 100 calc-energy)
    )
  )


  ; -------------------------------------------------------------------------
  ; Economic impact
  ; -------------------------------------------------------------------------

  let calc-econ (

    (agricultural-impact * 0.35) +
    (energy-stress * 0.30) +
    (water-stress * 0.15) +
    (local-risk * 0.20)

  )


  set economic-impact max (
    list 0 (
      min (list 100 calc-econ)
    )
  )


  ; -------------------------------------------------------------------------
  ; Recovery capacity
  ; -------------------------------------------------------------------------

  set recovery-capacity min (
    list 100 (

      (resilience * 0.40) +
      (effective-infrastructure * 0.30) +
      (effective-adaptation * 0.30)

    )
  )

end


; ============================================================================
; CASCADES
; ============================================================================

to propagate-cascades

  ; -------------------------------------------------------------------------
  ; Current-period cascade events
  ;
  ; This represents events generated during the CURRENT simulation tick.
  ; -------------------------------------------------------------------------

  set cascade-events 0


  ask municipalities [

    ; -----------------------------------------------------------------------
    ; Network-mediated spillover
    ; -----------------------------------------------------------------------

    if any? link-neighbors [

      let neighbor-risk (
        mean [local-risk] of link-neighbors
      )


      let spillover (

        (neighbor-risk *
         network-density *
         0.010)

        *

        (cascade-sensitivity *
         0.010)

      )


      ; ---------------------------------------------------------------------
      ; Persistent cascade memory
      ;
      ; Previous cascade load decays by 8% per tick.
      ; New spillover is then added.
      ; ---------------------------------------------------------------------

      set cascade-load max (
        list 0 (
          min (
            list 100 (
              (cascade-load * 0.92) +
              spillover
            )
          )
        )
      )

    ]


    ; -----------------------------------------------------------------------
    ; Cascade trigger #1
    ; Water + agriculture
    ; -----------------------------------------------------------------------

    if water-stress > 70 and
       agricultural-impact > 65 [

      set cascade-load min (
        list 100 (
          cascade-load + 7
        )
      )

      ; Current-tick counter
      set cascade-events (
        cascade-events + 1
      )

      ; Cumulative counter
      set total-cascade-events (
        total-cascade-events + 1
      )

    ]


    ; -----------------------------------------------------------------------
    ; Cascade trigger #2
    ; Agriculture + energy
    ; -----------------------------------------------------------------------

    if agricultural-impact > 70 and
       energy-stress > 65 [

      set cascade-load min (
        list 100 (
          cascade-load + 6
        )
      )

      set cascade-events (
        cascade-events + 1
      )

      set total-cascade-events (
        total-cascade-events + 1
      )

    ]


    ; -----------------------------------------------------------------------
    ; Cascade trigger #3
    ; Hazard + urban pressure
    ; -----------------------------------------------------------------------

    if hazard > 75 and
       urban-pressure > 70 [

      set cascade-load min (
        list 100 (
          cascade-load + 5
        )
      )

      set cascade-events (
        cascade-events + 1
      )

      set total-cascade-events (
        total-cascade-events + 1
      )

    ]


    ; -----------------------------------------------------------------------
    ; Cascade contribution to local risk
    ; -----------------------------------------------------------------------

    set local-risk max (
      list 0 (
        min (
          list 100 (
            local-risk +
            (cascade-load * 0.25)
          )
        )
      )
    )

  ]

end


; ============================================================================
; ADAPTATION
; ============================================================================

to apply-adaptation

  ask municipalities [

    ; -----------------------------------------------------------------------
    ; Monthly protective gains
    ; -----------------------------------------------------------------------

    let adaptation-gain (
      effective-adaptation * 0.020
    )


    let infrastructure-gain (
      effective-infrastructure * 0.015
    )


    ; -----------------------------------------------------------------------
    ; Resilience accumulation
    ; -----------------------------------------------------------------------

    set resilience min (
      list 100 (
        resilience + adaptation-gain
      )
    )


    ; -----------------------------------------------------------------------
    ; Damage mitigation
    ; -----------------------------------------------------------------------

    set damage max (
      list 0 (
        damage -
        adaptation-gain -
        infrastructure-gain
      )
    )


    ; -----------------------------------------------------------------------
    ; Cascade mitigation
    ; -----------------------------------------------------------------------

    set cascade-load max (
      list 0 (
        cascade-load -
        (adaptation-gain * 0.60)
      )
    )


    ; -----------------------------------------------------------------------
    ; Local risk mitigation
    ; -----------------------------------------------------------------------

    set local-risk max (
      list 0 (
        local-risk -
        adaptation-gain -
        infrastructure-gain
      )
    )

  ]

end


; ============================================================================
; DAMAGE / RECOVERY
; ============================================================================

to apply-recovery

  ask municipalities [

    ; -----------------------------------------------------------------------
    ; Incoming damage
    ; -----------------------------------------------------------------------

    let incoming-damage (

      (local-risk * 0.55) +
      (economic-impact * 0.20) +
      (cascade-load * 0.25)

    )


    ; -----------------------------------------------------------------------
    ; Recovery rate
    ; -----------------------------------------------------------------------

    let recovery (
      recovery-capacity * 0.020
    )


    ; -----------------------------------------------------------------------
    ; Damage accumulation
    ; -----------------------------------------------------------------------

    let calc-damage (

      damage +
      (incoming-damage * 0.35) -
      recovery

    )


    set damage max (
      list 0 (
        min (list 100 calc-damage)
      )
    )


    ; -----------------------------------------------------------------------
    ; Internal status
    ;
    ; This is model state, not a real-world classification.
    ; -----------------------------------------------------------------------

    set status classify-status local-risk damage

  ]

end


; ============================================================================
; GENERAL METRICS
; ============================================================================

to calculate-all-metrics

  ifelse any? municipalities [

    ; -----------------------------------------------------------------------
    ; Mean system indicators
    ; -----------------------------------------------------------------------

    set system-risk (
      mean [local-risk] of municipalities
    )


    set average-water-stress (
      mean [water-stress] of municipalities
    )


    set average-agricultural-impact (
      mean [agricultural-impact] of municipalities
    )


    set average-energy-stress (
      mean [energy-stress] of municipalities
    )


    set average-economic-impact (
      mean [economic-impact] of municipalities
    )


    set average-damage (
      mean [damage] of municipalities
    )


    set average-recovery-capacity (
      mean [recovery-capacity] of municipalities
    )


    ; -----------------------------------------------------------------------
    ; Peaks
    ; -----------------------------------------------------------------------

    set peak-system-risk (
      max (
        list peak-system-risk system-risk
      )
    )


    set peak-average-damage (
      max (
        list peak-average-damage average-damage
      )
    )


    ; -----------------------------------------------------------------------
    ; Critical municipalities
    ; -----------------------------------------------------------------------

    set critical-municipalities (
      count municipalities with [
        local-risk >= 75 or
        damage >= 75
      ]
    )


    ; -----------------------------------------------------------------------
    ; Total system cascade load
    ; -----------------------------------------------------------------------

    set total-cascade-load (
      sum [cascade-load] of municipalities
    )


    ; -----------------------------------------------------------------------
    ; Actual network statistics
    ; -----------------------------------------------------------------------

    calculate-network-metrics

  ] [

    ; -----------------------------------------------------------------------
    ; Empty model fallback
    ; -----------------------------------------------------------------------

    set system-risk 0

    set average-water-stress 0
    set average-agricultural-impact 0
    set average-energy-stress 0
    set average-economic-impact 0
    set average-damage 0
    set average-recovery-capacity 0

    set peak-system-risk 0
    set peak-average-damage 0

    set critical-municipalities 0

    set total-cascade-load 0

    set network-edge-count 0
    set network-mean-degree 0
    set network-realized-density 0

  ]

end


; ============================================================================
; STATUS CLASSIFICATION
; ============================================================================

to-report classify-status [risk-value damage-value]

  if risk-value < 25 and
     damage-value < 25 [

    report "STABLE"

  ]


  if risk-value < 50 and
     damage-value < 50 [

    report "WARNING"

  ]


  if risk-value < 75 and
     damage-value < 75 [

    report "HIGH"

  ]


  report "CRITICAL"

end


; ============================================================================
; FORMAL EXPERIMENT METRICS
; ============================================================================
;
; These reporters expose reproducibility, cascade, and observed network
; structure as formal model outputs for BehaviorSpace, headless execution,
; CSV export, or other automated experiment runners.
;
; The user-facing "network-density" remains an input/control parameter.
; "network-realized-density" is the measured density of the generated graph.
; ============================================================================

to-report metric-experiment-seed

  report random-seed-value

end


to-report metric-cascade-events-current

  report cascade-events

end


to-report metric-cascade-events-total

  report total-cascade-events

end


to-report metric-cascade-event-rate

  ifelse ticks > 0 [
    report total-cascade-events / ticks
  ] [
    report 0
  ]

end


to-report metric-network-edge-count

  report network-edge-count

end


to-report metric-network-mean-degree

  report network-mean-degree

end


to-report metric-network-realized-density

  report network-realized-density

end


; ============================================================================
; SCENARIO COMMANDS
; ============================================================================

to setup-scenario [scenario-name seed-value]
  set scenario-mode scenario-name
  setup-with-seed seed-value
end


to scenario-fail-open
  setup-scenario "FAIL OPEN" 20260916
end


to scenario-balanced
  setup-scenario "BALANCED" 20260916
end


to scenario-resilient
  setup-scenario "RESILIENT BY DESIGN" 20260916
end

; ============================================================================
; SCENARIO COMPARISON
; ============================================================================
;
; Executes the three predefined scenarios under the same initial conditions:
; - same random seed
; - same number of municipalities
; - same network-generation process
; - same 60-month experimental horizon
;
; The procedure reports comparative outputs without declaring a preferred
; scenario.
; ============================================================================

to compare-scenarios

  let comparison-seed 20260916
  let original-scenario scenario-mode

  ; --------------------------------------------------------------------------
  ; HEADER
  ; --------------------------------------------------------------------------

  print ""
  print "======================================================================"
  print "                     SCENARIO COMPARISON"
  print "======================================================================"

  print (word "Seed: " comparison-seed)
  print "Simulation horizon: 60 months"
  print ""

  print "Scenario                 Final Risk   Peak Risk   Final Damage   Cascades"
  print "----------------------------------------------------------------------"


  ; --------------------------------------------------------------------------
  ; FAIL OPEN
  ; --------------------------------------------------------------------------

  setup-scenario "FAIL OPEN" comparison-seed

  while [ticks < 60] [
    go
  ]

  let fail-final-risk system-risk
  let fail-peak-risk peak-system-risk
  let fail-final-damage average-damage
  let fail-cascades total-cascade-events

  print (
    word
      "FAIL OPEN                "
      (precision fail-final-risk 2)
      "          "
      (precision fail-peak-risk 2)
      "          "
      (precision fail-final-damage 2)
      "          "
      fail-cascades
  )


  ; --------------------------------------------------------------------------
  ; BALANCED
  ; --------------------------------------------------------------------------

  setup-scenario "BALANCED" comparison-seed

  while [ticks < 60] [
    go
  ]

  let balanced-final-risk system-risk
  let balanced-peak-risk peak-system-risk
  let balanced-final-damage average-damage
  let balanced-cascades total-cascade-events

  print (
    word
      "BALANCED                 "
      (precision balanced-final-risk 2)
      "          "
      (precision balanced-peak-risk 2)
      "          "
      (precision balanced-final-damage 2)
      "          "
      balanced-cascades
  )


  ; --------------------------------------------------------------------------
  ; RESILIENT BY DESIGN
  ; --------------------------------------------------------------------------

  setup-scenario "RESILIENT BY DESIGN" comparison-seed

  while [ticks < 60] [
    go
  ]

  let resilient-final-risk system-risk
  let resilient-peak-risk peak-system-risk
  let resilient-final-damage average-damage
  let resilient-cascades total-cascade-events

  print (
    word
      "RESILIENT BY DESIGN      "
      (precision resilient-final-risk 2)
      "          "
      (precision resilient-peak-risk 2)
      "          "
      (precision resilient-final-damage 2)
      "          "
      resilient-cascades
  )


  ; --------------------------------------------------------------------------
  ; NETWORK STRUCTURE
  ; --------------------------------------------------------------------------
  ;
  ; Because all scenarios use the same seed, the synthetic network should
  ; remain structurally identical across the three runs.
  ; --------------------------------------------------------------------------

  print ""
  print "----------------------------------------------------------------------"
  print "CONTROLLED NETWORK STRUCTURE"
  print (word "Network edges: "
             network-edge-count)
  print (word "Network mean degree: "
             precision network-mean-degree 2)
  print (word "Network realized density: "
             precision network-realized-density 4)


  ; --------------------------------------------------------------------------
  ; COMPARISON METRICS
  ; --------------------------------------------------------------------------

  print ""
  print "CASCADE EVENT RATE"
  print (word
           "FAIL OPEN: "
           precision (fail-cascades / 60) 2
           " events/month")

  print (word
           "BALANCED: "
           precision (balanced-cascades / 60) 2
           " events/month")

  print (word
           "RESILIENT BY DESIGN: "
           precision (resilient-cascades / 60) 2
           " events/month")


  ; --------------------------------------------------------------------------
  ; FOOTER
  ; --------------------------------------------------------------------------

  print ""
  print "----------------------------------------------------------------------"
  print "Comparison completed using the same experimental seed."
  print "Values represent model outputs on normalized 0–100 scales."
  print "No scenario is automatically classified as preferred."
  print "======================================================================"
  print ""


  ; --------------------------------------------------------------------------
  ; RESTORE USER'S PREVIOUS SCENARIO
  ; --------------------------------------------------------------------------
  ;
  ; Reinitialize the model so the interface is not left displaying one
  ; scenario while another scenario is selected.
  ; --------------------------------------------------------------------------

  set scenario-mode original-scenario
  setup

end


; ============================================================================
; SUMMARY
; ============================================================================

to print-summary

  print (
    word
      "=== CLIMATE STRESS TEST — "
      current-year
      " ==="
  )


  print (
    word
      "Scenario: "
      scenario-mode
  )


  print (
    word
      "Random seed: "
      random-seed-value
  )


  print (
    word
      "Ticks: "
      ticks
  )


  print (
    word
      "Systemic risk: "
      precision system-risk 2
  )


  print (
    word
      "Peak systemic risk: "
      precision peak-system-risk 2
  )


  print (
    word
      "Water stress: "
      precision average-water-stress 2
  )


  print (
    word
      "Agricultural impact: "
      precision average-agricultural-impact 2
  )


  print (
    word
      "Energy stress: "
      precision average-energy-stress 2
  )


  print (
    word
      "Economic impact: "
      precision average-economic-impact 2
  )


  print (
    word
      "Average damage: "
      precision average-damage 2
  )


  print (
    word
      "Peak average damage: "
      precision peak-average-damage 2
  )


  print (
    word
      "Average recovery capacity: "
      precision average-recovery-capacity 2
  )


  print (
    word
      "Critical municipalities: "
      critical-municipalities
  )


  ; Current simulation tick
  print (
    word
      "Cascade events this tick: "
      cascade-events
  )


  ; Accumulated simulation total
  print (
    word
      "Total cascade events: "
      total-cascade-events
  )


  print (
    word
      "Total cascade load: "
      precision total-cascade-load 2
  )


  ; Actual generated network statistics
  print (
    word
      "Network edges: "
      network-edge-count
  )


  print (
    word
      "Network mean degree: "
      precision network-mean-degree 2
  )


  print (
    word
      "Network realized density: "
      precision network-realized-density 4
  )

end


; ============================================================================
; REPRODUCIBILITY / REPLICATION TEST
; ============================================================================

to replication-test [number-of-runs]

  let run-id 1


  repeat number-of-runs [

    ; -----------------------------------------------------------------------
    ; Each replication receives an independent seed.
    ;
    ; IMPORTANT:
    ; We call setup-with-seed directly.
    ; We DO NOT call setup here, because setup intentionally uses the
    ; fixed reproducibility seed 20260916.
    ; -----------------------------------------------------------------------

    let replication-seed (
      20260916 + run-id
    )


    setup-with-seed replication-seed


    ; -----------------------------------------------------------------------
    ; Run complete 60-month trajectory
    ; -----------------------------------------------------------------------

    while [ticks < 60] [
      go
    ]


    ; -----------------------------------------------------------------------
    ; Output
    ; -----------------------------------------------------------------------

    print (

      word
        "REPLICATION "
        run-id
        " | SEED="
        random-seed-value
        " | SYSTEM_RISK="
        precision system-risk 2
        " | PEAK_RISK="
        precision peak-system-risk 2
        " | DAMAGE="
        precision average-damage 2
        " | CASCADE_EVENTS="
        total-cascade-events
        " | NETWORK_MEAN_DEGREE="
        precision network-mean-degree 2
        " | NETWORK_DENSITY="
        precision network-realized-density 4

    )


    set run-id (
      run-id + 1
    )

  ]

end
  ]]></code>
